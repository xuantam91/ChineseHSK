# ==========================================
# Chinese Learning Journey — Environment Config
# ==========================================

# Base URL of the web application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
# Public Supabase URL (safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon/publishable key (safe for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Service Role Key (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set to "true" to enable in-memory mock Supabase for local dev without credentials
USE_MOCK_SUPABASE=true

# ------------------------------------------
# Notion Integration (Optional / Admin Only)
# ------------------------------------------
NOTION_API_TOKEN=
NOTION_ROOT_PAGE_ID=129db0ebd82b4b5cb9c13a343a937567

# ------------------------------------------
# Google Drive Integration (Optional / Admin Only)
# ------------------------------------------
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ------------------------------------------
# Cron & Maintenance Secrets
# ------------------------------------------
CRON_SECRET=
